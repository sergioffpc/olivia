#!/usr/bin/env bash
# Turns one side-on video into one animation file:
#   tools/mocap/mocap <video> <output.json> [--joints a,b] [--start seconds] [--end seconds]
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
model="$here/models/pose_landmarker_heavy.task"
url="https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_heavy/float16/1/pose_landmarker_heavy.task"
sha256="64437af838a65d18e5ba7a0d39b465540069bc8aae8308de3e318aad31fcbc7b"

# With network, and with no MediaPipe code running.
uv sync --locked --quiet --project "$here"
if [[ ! -f "$model" ]]; then
    mkdir -p "$(dirname "$model")"
    curl --fail --location --silent --show-error --output "$model.part" "$url"
    echo "$sha256  $model.part" | sha256sum --check --quiet
    mv "$model.part" "$model"
fi

# With no network: MediaPipe contacts Google without being asked. `uv run` may need the network.
exec unshare -rn "$here/.venv/bin/python" "$here/mocap.py" "$@"
